<?xml version="1.0" encoding="windows-1251"?>
<!--
    Anomaly Modern Main Menu
    Style: Modern Zone
    Compatible with MCM
-->
<w>
    <!-- ======================== BACKGROUND ======================== -->
    <background x="0" y="0" width="1024" height="768">
        <!-- Main atmospheric background -->
        <auto_static x="0" y="0" width="1024" height="768" stretch="1">
            <texture x="0" y="0" width="1920" height="1080">ui\ui_mm_modern_bg</texture>
        </auto_static>

        <!-- Subtle dark vignette / side panel overlay -->
        <auto_static x="680" y="0" width="344" height="768" stretch="1">
            <texture a="160" r="8" g="12" b="18">ui\ui_mm_modern_panel</texture>
        </auto_static>

        <!-- Modern logo -->
        <auto_static x="720" y="55" width="260" height="110" stretch="1">
            <texture a="230">ui\ui_mm_modern_logo</texture>
        </auto_static>
    </background>

    <!-- ======================== SHNIAGA (slider) ======================== -->
    <shniaga_wnd x="700" y="200" width="300" height="420">
        <buttons_region x="0" y="0" width="280" height="420" always_show_scroll="false" vert_interval="12"/>
        
        <shniaga x="0" y="0" width="280" height="48" stretch="1">
            <!-- Modern thin slider with accent glow -->
            <texture x="0" y="0" width="560" height="96" a="255" r="46" g="230" b="166">ui\ui_mm_modern_slider</texture>
            <magnifire x="0" y="0" width="280" height="48" stretch="1">
                <texture x="0" y="0" width="560" height="96">ui\ui_mm_modern_slider</texture>
                <y_offset>0</y_offset>
            </magnifire>
        </shniaga>
    </shniaga_wnd>

    <button h="42"/>

    <!-- ======================== MAIN MENU ======================== -->
    <menu_main btn_height="42" font="letterica18" a="255" r="232" g="240" b="242">
        <btn name="btn_newgame"     caption="ui_mm_newgame" />
        <btn name="btn_load"        caption="ui_mm_load_game" />
        <btn name="btn_lastsave"    caption="ui_mm_last_save" />
        <btn name="btn_options"     caption="ui_mm_options_n" />
        <btn name="btn_mcm"         caption="ui_mm_menu_mcm" />
        <btn name="btn_quit"        caption="ui_mm_quit2windows" />
    </menu_main>

    <menu_network_game btn_height="42" font="letterica18" a="255" r="232" g="240" b="242">
        <btn name="btn_internet"    caption="ui_mp_internet" />
        <btn name="btn_localnet"    caption="ui_mp_localnet" />
        <btn name="btn_new_back"    caption="ui_mm_back" />
    </menu_network_game>

    <menu_main_logout btn_height="42" font="letterica18" a="255" r="232" g="240" b="242">
        <btn name="btn_newgame"     caption="ui_mm_newgame" />
        <btn name="btn_load"        caption="ui_mm_load_game" />
        <btn name="btn_logout"      caption="ui_mm_logout" />
        <btn name="btn_options"     caption="ui_mm_options_n" />
        <btn name="btn_mcm"         caption="ui_mm_menu_mcm" />
        <btn name="btn_quit"        caption="ui_mm_quit2windows" />
    </menu_main_logout>

    <menu_main_last_save btn_height="42" font="letterica18" a="255" r="232" g="240" b="242">
        <btn name="btn_newgame"     caption="ui_mm_newgame" />
        <btn name="btn_load"        caption="ui_mm_load_game" />
        <btn name="btn_lastsave"    caption="ui_mm_last_save" />
        <btn name="btn_options"     caption="ui_mm_options_n" />
        <btn name="btn_mcm"         caption="ui_mm_menu_mcm" />
        <btn name="btn_quit"        caption="ui_mm_quit2windows" />
    </menu_main_last_save>

    <menu_new_game btn_height="42" font="letterica18" a="255" r="232" g="240" b="242">
        <btn name="btn_novice"      caption="ui_mm_novice" />
        <btn name="btn_stalker"     caption="ui_mm_stalker" />
        <btn name="btn_veteran"     caption="ui_mm_veteran" />
        <btn name="btn_master"      caption="ui_mm_master" />
        <btn name="btn_new_back"    caption="ui_mm_back" />
    </menu_new_game>

    <menu_main_single btn_height="42" font="letterica18" a="255" r="232" g="240" b="242">
        <btn name="btn_ret"         caption="ui_mm_return_game" />
        <btn name="btn_lastsave"    caption="ui_mm_last_save" />
        <btn name="btn_load"        caption="ui_mm_load_game" />
        <btn name="btn_save"        caption="ui_mm_save_game" />
        <btn name="btn_options"     caption="ui_mm_options_n" />
        <btn name="btn_mcm"         caption="ui_mm_menu_mcm" />
        <btn name="btn_quit_to_mm"  caption="ui_mm_quit_game" />
        <btn name="btn_quit"        caption="ui_mm_quit2windows" />
    </menu_main_single>

    <menu_main_single_dead btn_height="42" font="letterica18" a="255" r="232" g="240" b="242">
        <btn name="btn_lastsave"    caption="ui_mm_last_save" />
        <btn name="btn_load"        caption="ui_mm_load_game" />
        <btn name="btn_options"     caption="ui_mm_options_n" />
        <btn name="btn_mcm"         caption="ui_mm_menu_mcm" />
        <btn name="btn_quit_to_mm"  caption="ui_mm_quit_game" />
        <btn name="btn_quit"        caption="ui_mm_quit2windows" />
    </menu_main_single_dead>

    <menu_main_mm btn_height="42" font="letterica18" a="255" r="232" g="240" b="242">
        <btn name="btn_ret"         caption="ui_mm_return_game" />
        <btn name="btn_options"     caption="ui_mm_options_n" />
        <btn name="btn_mcm"         caption="ui_mm_menu_mcm" />
        <btn name="btn_quit_to_mm"  caption="ui_mm_disconnect" />
        <btn name="btn_quit"        caption="ui_mm_quit2windows" />
    </menu_main_mm>

    <!-- ======================== SOUND ======================== -->
    <menu_sound random="0">
        <whell_click>ui_menu_click</whell_click>
        <menu_music>music\modern_menu_theme</menu_music>
    </menu_sound>

    <!-- ======================== VERSION & DISCLAIMER ======================== -->
    <static_version x="20" y="735">
        <text align="l" font="letterica16" r="139" g="160" b="168" complex_mode="0"/>
    </static_version>

    <static_disclaimer x="20" y="710">
        <text align="l" font="letterica16" r="100" g="120" b="128" complex_mode="1"/>
    </static_disclaimer>

    <msg_wnd x="0" y="0" width="280" height="120">
        <background x="0" y="0" width="280" height="120">
            <texture>ui_icons_PDA_tooltips</texture>
        </background>
        <text x="18" y="18" width="250" height="90">
            <text font="letterica18" color="ui_6" complex_mode="1" align="l" vert_align="t"/>
        </text>
    </msg_wnd>
</w>
